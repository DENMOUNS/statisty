<?xml version="1.0"?>
<ruleset name="Statisty">
    <description>PHP CodeSniffer rules for the Statisty package.</description>

    <file>src</file>
    <file>tests</file>

    <rule ref="PSR12">
        <exclude name="PSR1.Methods.CamelCapsMethodName"/>
    </rule>

    <!-- Désactive complètement le sniff -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>*</exclude-pattern>
    </rule>
</ruleset>