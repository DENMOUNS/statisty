{
    "name": "ld/statisty",
    "description": "Laravel Analytics & Observability Engine",
    "type": "library",
    "license": "proprietary",
    "version": "1.0.0",
    "keywords": [
        "laravel",
        "analytics",
        "observability",
        "dashboard",
        "eloquent",
        "business-intelligence"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Statisty\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Statisty\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Statisty\\Infrastructure\\StatistyServiceProvider"
            ],
            "aliases": {
                "Statisty": "Statisty\\Facades\\Statisty"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Denmouns",
            "email": "landrymoutongo97@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
